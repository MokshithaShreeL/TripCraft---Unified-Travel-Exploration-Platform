# ==============================================================================
# TripCraft v2 Server Configuration
# ==============================================================================

# Port to serve the application and REST APIs
PORT=3000

# ------------------------------------------------------------------------------
# 1. EMAIL NOTIFICATIONS (Gmail / SMTP via Nodemailer)
# ------------------------------------------------------------------------------
# How to get Gmail App Password:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Go to App Passwords: https://myaccount.google.com/apppasswords
# 3. Create a new app name (e.g. "TripCraft") and generate a 16-letter password.
# 4. Paste that 16-letter password below without spaces into SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-16-letter-app-password
MAIL_FROM="TripCraft <yourname@gmail.com>"

# ------------------------------------------------------------------------------
# 2. SMS & WHATSAPP NOTIFICATIONS (Twilio)
# ------------------------------------------------------------------------------
# How to get Twilio Credentials:
# 1. Sign up or log into https://console.twilio.com/
# 2. Copy your Account SID and Auth Token from the Twilio Console dashboard.
# 3. For SMS: Use your assigned Twilio Phone Number in E.164 format (+1XXXXXXXXXX).
#    Note: Twilio trial accounts can only send SMS to numbers verified in your Twilio console.
# 4. For WhatsApp: Use your Twilio WhatsApp Sandbox number (e.g. whatsapp:+14155238886).
#    Note: Recipients must first join your sandbox by sending the join code to that number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
